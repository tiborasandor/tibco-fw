{% extends 'app.twig' %}

{% block content %}
    <div class="container py-5">
        <h1 class="h3 mb-3"><i class="bi bi-shield-lock me-1"></i> Védett oldal</h1>
        <p>Ezt az oldalt csak bejelentkezett felhasználó látja - az <code>app/middlewares/AuthMiddleware.php</code> engedett át.</p>
        <div class="card">
            <div class="card-header">A request <code>user</code> attribútuma</div>
            <div class="card-body">
                <dl class="row mb-0">
                    {% for key, value in user %}
                        <dt class="col-sm-2">{{ key }}</dt>
                        <dd class="col-sm-10">{{ value }}</dd>
                    {% endfor %}
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
