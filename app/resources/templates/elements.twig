{#
    Közös építőelemek az app.twig-hez (és bármelyik sablonhoz):
    {{ block('navbar', 'elements.twig') }}
    A téma Bootstrap 5.3.8 + Bootstrap Icons 1.13.1, helyben a
    public/assets/vendor/ mappában (build lépés nélkül) - saját témánál
    ezeket a blokkokat kell lecserélni.
#}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-expand-md bg-body-tertiary border-bottom">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ url_for('main_page') }}">
                <i class="bi bi-boxes me-1"></i> Tibco
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Menü">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ is_active_path('main_page') }}" href="{{ url_for('main_page') }}">Kezdőlap</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ is_active_path('example_secret') }}" href="{{ url_for('example_secret') }}">Védett oldal</a>
                    </li>
                </ul>
                {# a `user` változót az app/middlewares/AuthMiddleware.php állítja be #}
                {% if user is defined and user %}
                    <form method="post" action="{{ url_for('example_logout') }}" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
                        <span class="navbar-text"><i class="bi bi-person-circle me-1"></i>{{ user.name }}</span>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Kijelentkezés</button>
                    </form>
                {% else %}
                    <form method="post" action="{{ url_for('example_login') }}">
                        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
                        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i> Demo bejelentkezés</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </nav>
{% endblock %}

{% block flash %}
    {# odan/session Flash: típus => üzenetek; a típusnevek Bootstrap alert színekre képezve #}
    {% set alertClasses = {'success': 'success', 'error': 'danger', 'danger': 'danger', 'warning': 'warning', 'info': 'info'} %}
    {% set flashMessages = flash ? flash.all() : [] %}
    {% if flashMessages is not empty %}
        <div class="container mt-3">
            {% for type, messages in flashMessages %}
                {% for message in messages %}
                    <div class="alert alert-{{ alertClasses[type] ?? 'secondary' }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block footer %}
    <footer class="border-top py-4 mt-5">
        <div class="container small text-body-secondary d-flex justify-content-between">
            <span>Tibco keretrendszer</span>
            <span>Slim 4 · PHP-DI · Twig · Bootstrap 5</span>
        </div>
    </footer>
{% endblock %}

{% block scripts %}
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
{% endblock %}
